@model List<Tutor_Manager.ViewModels.TutorListItemViewModel>
@{
    ViewData["Title"] = "Tutor Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Tutors</h2>
    <form asp-action="GenerateForAllUnassigned" method="post" class="d-inline">
        <button type="submit" class="btn btn-sm btn-primary">
            <i class="bi bi-stars"></i> Generate AI Recommendations
        </button>
    </form>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Tutor</th>
            <th>Tutor #</th>
            <th>Subjects Taught</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var tutor in Model)
        {
            <tr>
                <td>@tutor.FullName</td>
                <td>@tutor.TutorNumber</td>
                <td>
                    @if (tutor.SubjectGradeSummary.Any())
                    {
                        @string.Join(", ", tutor.SubjectGradeSummary)
                    }
                    else
                    {
                        <span class="text-muted">No subjects assigned</span>
                    }
                </td>
                <td>
                    @if (tutor.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td class="text-end">
                    <a asp-action="Subjects" asp-route-id="@tutor.TutorUserId" class="btn btn-sm btn-outline-primary">Subjects</a>
                    @* <a asp-action="Availability" asp-route-id="@tutor.TutorUserId" class="btn btn-sm btn-outline-primary">Availability</a> *@
                    <a asp-action="Unavailability" asp-route-id="@tutor.TutorUserId" class="btn btn-sm btn-outline-primary">Leave</a>
                    <form asp-action="ToggleActive" asp-route-id="@tutor.TutorUserId" method="post" class="d-inline">
                        <input type="hidden" name="isActive" value="@(!tutor.IsActive ? "true" : "false")" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                            @(tutor.IsActive ? "Deactivate" : "Activate")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>