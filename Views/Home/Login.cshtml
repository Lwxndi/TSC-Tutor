@model Tutor_Manager.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Log In";
    Layout = null; // Standalone auth page
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Log In - The Science Community</title>

    <!-- External CSS -->
    <link rel="stylesheet" href="~/css/Auth-login.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,500&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>

    <div class="auth-container">
        <!-- Left Side: Visual Branding Panel -->
        <div class="brand-panel">
            <div class="brand-header">
                <div class="brand-icon">
                    <i class="bi bi-gear-wide-connected"></i>
                </div>
                <div>
                    <div class="brand-title">The Science Community</div>
                    <div class="brand-subtitle">TUTORING PLATFORM</div>
                </div>
            </div>

            <div class="brand-content">
                <div class="tag-group">
                    <span class="tag">Hybrid Learning</span>
                    <span class="tag">Live Classes</span>
                    <span class="tag">Progress Tracking</span>
                </div>
                <div class="brand-quote">
                    "Empowering students across South Africa to learn without limits."
                </div>
                <div class="brand-author">Michael Vilankulu &mdash; The Science Community</div>
            </div>
        </div>

        <!-- Right Side: Login Form Panel -->
        <div class="form-panel">
            <div class="auth-card">
                <div class="auth-title">Welcome back</div>
                <div class="auth-subtitle">Sign in to your account to continue</div>

                <!-- Role Tab Buttons (Visual representation matching UI) -->
                <div class="role-selector">
                    <button type="button" class="role-btn active"><i class="bi bi-mortarboard-fill"></i> Student</button>
                    <button type="button" class="role-btn"><i class="bi bi-person-fill"></i> Parent</button>
                    <button type="button" class="role-btn"><i class="bi bi-journal-bookmark-fill"></i> Tutor</button>
                    <button type="button" class="role-btn"><i class="bi bi-gear-fill"></i> Admin</button>
                </div>

                <form asp-controller="Home" asp-action="Login" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                    <div class="auth-field">
                        <label asp-for="Email">Email address</label>
                        <input asp-for="Email" type="email" placeholder="you@example.com" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Password">Password</label>
                        <div class="input-wrapper">
                            <input asp-for="Password" id="passwordInput" type="password" placeholder="Enter your password" autocomplete="current-password" />
                            <button type="button" class="toggle-password" onclick="togglePasswordVisibility()">Show</button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="auth-options">
                        <div class="auth-checkbox-row">
                            <input asp-for="RememberMe" id="RememberMe" />
                            <label asp-for="RememberMe">Remember me</label>
                        </div>
                        <a href="#" class="forgot-link">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn-auth">Sign in</button>
                </form>
            </div>

            <div class="auth-footer-link">
                Don't have an account? <a asp-controller="Home" asp-action="RegisterLearner">Create account</a>
            </div>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />

    <script>
            function togglePasswordVisibility() {
                const passwordInput = document.getElementById('passwordInput');
                const toggleBtn = document.querySelector('.toggle-password');
                if (passwordInput.type === 'password') {
                    passwordInput.type = 'text';
                    toggleBtn.textContent = 'Hide';
                } else {
                    passwordInput.type = 'password';
                    toggleBtn.textContent = 'Show';
                }
            }
    </script>
</body>
</html>
