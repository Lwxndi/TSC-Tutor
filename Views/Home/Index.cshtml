@{
    ViewData["Title"] = "The Science Community - Tutoring Platform";
}

<link rel="stylesheet" href="~/css/home-landing.css" asp-append-version="true" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,500&family=IBM+Plex+Mono:wght@400;500;700&display=swap" rel="stylesheet">

<div class="landing">

    <nav class="nav">
        <div class="nav-links">
            <a href="#about">ABOUT</a><a href="#operate">METHOD</a><a href="#tutors">TUTORS</a><a href="#contact">CONTACT</a>
        </div>
        <a asp-controller="Home" asp-action="Login" class="nav-cta">SIGN IN</a>
    </nav>

    <section class="hero">
        <div class="inner">
            <div class="hero-top">GRADE 8–12 &middot; MBOMBELA &amp; CAPE TOWN</div>
            <h1>Science that clicks, not just recites.</h1>
            <div class="hero-body">
                <div>
                    <p>Small group sessions, real tutors, and a library that's open whenever you need it — built for students who learn better together.</p>
                    <div class="hero-actions">
                        <a asp-controller="Home" asp-action="RegisterLearner" class="btn-fill">Register your account</a>
                        <a href="#operate" class="btn-line">See how it works &rarr;</a>
                    </div>
                </div>
                <div class="hero-photo">
                    <img src="https://images.unsplash.com/photo-1532094349884-543bc11b234d?auto=format&fit=crop&q=80&w=700" alt="Students in a group tutoring session" />
                </div>
            </div>
        </div>
    </section>

    <div class="ticker-wrap">
        <div class="ticker">
            <div class="tick-item"><b>100+</b> students tutored</div>
            <div class="tick-item"><b>95%</b> pass rate</div>
            <div class="tick-item"><b>6</b> subjects offered</div>
            <div class="tick-item"><b>2</b> cities &amp; counting</div>
            <div class="tick-item"><b>100+</b> students tutored</div>
            <div class="tick-item"><b>95%</b> pass rate</div>
            <div class="tick-item"><b>6</b> subjects offered</div>
            <div class="tick-item"><b>2</b> cities &amp; counting</div>
        </div>
    </div>

    <section class="about" id="about">
        <div class="inner">
            <h2>Founded on the belief that every student deserves good science teaching.</h2>
            <p>The Science Community was started by <strong>Michael Vilankulu</strong> in Mbombela. What began as group sessions in a single room has grown into a hybrid platform serving students from Mbombela to Cape Town — and beyond.</p>
            <div class="about-tags">
                <span>Group learning</span><span>Hybrid sessions</span><span>Expert tutors</span><span>Proven results</span>
            </div>
        </div>
    </section>

    <section class="steps" id="operate">
        <div class="inner">
            <h2>Simple, structured, effective.</h2>
            <p>From sign-up to exam day, every step is designed to support students and give parents full visibility.</p>
            <div class="tline">
                <div class="trow"><div class="tdot"></div><div class="tbody"><div class="tno">STEP 1</div><h3>Register your account</h3><p>Sign up as a student, parent, or tutor — under two minutes.</p></div></div>
                <div class="trow"><div class="tdot"></div><div class="tbody"><div class="tno">STEP 2</div><h3>Join a group session</h3><p>Browse scheduled classes by subject and grade.</p></div></div>
                <div class="trow"><div class="tdot"></div><div class="tbody"><div class="tno">STEP 3</div><h3>Access resources anytime</h3><p>Notes, past papers and recordings, day or night.</p></div></div>
                <div class="trow"><div class="tdot"></div><div class="tbody"><div class="tno">STEP 4</div><h3>Track your progress</h3><p>Attendance, homework and results, in real time.</p></div></div>
            </div>
        </div>
    </section>

    <section class="periodic">
        <div class="inner">
            <h2>Grade 8&ndash;12 curriculum</h2>
            <div class="pgrid">
                <div class="ptile"><span class="pi">01</span><span class="ps">Mt</span><span class="pn">Mathematics</span></div>
                <div class="ptile"><span class="pi">02</span><span class="ps">Ps</span><span class="pn">Physical Sciences</span></div>
                <div class="ptile"><span class="pi">03</span><span class="ps">Ls</span><span class="pn">Life Sciences</span></div>
                <div class="ptile"><span class="pi">04</span><span class="ps">Ac</span><span class="pn">Accounting</span></div>
                <div class="ptile"><span class="pi">05</span><span class="ps">Gg</span><span class="pn">Geography</span></div>
                <div class="ptile"><span class="pi">06</span><span class="ps">En</span><span class="pn">English</span></div>
            </div>
        </div>
    </section>

    <section class="tutors" id="tutors">
        <div class="inner">
            <h2>Experts who care.</h2>
            <p>APPLY AS A TUTOR &rarr;</p>
            <div class="filmstrip">
                <div class="film-card">
                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=400" alt="Michael Vilankulu" />
                    <div class="film-info"><h4>Michael Vilankulu</h4><div class="role">FOUNDER &amp; LEAD TUTOR</div><div class="subj">Mathematics, Physical Sciences</div></div>
                </div>
                <div class="film-card">
                    <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&q=80&w=400" alt="Amara Osei" />
                    <div class="film-info"><h4>Amara Osei</h4><div class="role">SENIOR TUTOR</div><div class="subj">Life Sciences, Accounting</div></div>
                </div>
                <div class="film-card">
                    <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&q=80&w=400" alt="Sipho Ndlovu" />
                    <div class="film-info"><h4>Sipho Ndlovu</h4><div class="role">MATHEMATICS TUTOR</div><div class="subj">Mathematics, Geography</div></div>
                </div>
                <div class="film-card hire">
                    <span class="hbadge">HIRING</span>
                    <h4 style="font-family:var(--grot)">Join the team</h4>
                    <div class="subj">All subjects considered</div>
                </div>
            </div>
        </div>
    </section>

    <section class="stage">
        <div class="stage-inner">
            <div class="qmark">&quot;</div>
            <p class="quote" id="sQuote">Before The Science Community, I was failing Maths. After just one term with Michael, I got 78%. The group sessions made everything click — you learn from your peers too, not just the tutor.</p>
            <div class="stage-author">
                <div class="savatar" id="sAvatar">LD</div>
                <div><strong id="sName">Lerato Dlamini</strong><span id="sRole">Grade 11 Student, Mbombela</span></div>
            </div>
            <div class="stage-tabs">
                <button type="button" class="active" data-key="lerato">Lerato</button>
                <button type="button" data-key="grace">Grace</button>
                <button type="button" data-key="sipho">Sipho</button>
                <button type="button" data-key="ayanda">Ayanda</button>
            </div>
        </div>
    </section>

    <section class="contact rail-section" id="contact">
        <div class="rail">FIG. 06 — CONTACT</div>
        <div class="inner">
            <h2>Let's get you started.</h2>
            <div class="contact">
                <div class="inner" style="padding:0">
                    <div>
                        <p class="contact-blurb">Have a question about sessions, pricing, or how to enrol? Reach out — we respond within 24 hours.</p>
                        <div class="citem"><div class="l">LOCATIONS</div><strong>Cape Town &middot; Mbombela &middot; Online</strong></div>
                        <div class="citem"><div class="l">EMAIL</div><strong>hello@sciencecommunity.co.za</strong></div>
                        <div class="citem"><div class="l">WHATSAPP</div><strong>+27 71 000 0000</strong></div>
                    </div>
                    <div class="lform">
                        <form id="homeContactForm">
                            <div class="fld"><label>YOUR NAME</label><input type="text" placeholder="e.g. Lerato Dlamini" required /></div>
                            <div class="fld"><label>EMAIL ADDRESS</label><input type="email" placeholder="lerato@example.com" required /></div>
                            <div class="fld"><label>MESSAGE</label><textarea rows="3" placeholder="Tell us what you need help with..." required></textarea></div>
                            <button type="submit">Send message</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <footer>
        <div class="inner">
            <div>
                <h5 style="font-family:var(--grot);font-size:1rem;color:var(--ink);margin-bottom:.5rem">The Science Community</h5>
                <p>Empowering South African students through expert, accessible science tutoring.</p>
            </div>
            <div>
                <h5>PLATFORM</h5>
                <ul class="flinks">
                    <li><a href="#about">About us</a></li>
                    <li><a href="#tutors">Our tutors</a></li>
                    <li><a href="#operate">How we operate</a></li>
                    <li><a href="#contact">Contact us</a></li>
                </ul>
            </div>
            <div>
                <h5>ACCOUNT</h5>
                <ul class="flinks">
                    <li><a asp-controller="Home" asp-action="Login">Sign in</a></li>
                    <li><a asp-controller="Home" asp-action="RegisterLearner">Create account</a></li>
                </ul>
            </div>
        </div>
        <div class="fbottom">
            <div>&copy; 2026 THE SCIENCE COMMUNITY</div>
            <div>CAPE TOWN &middot; MBOMBELA &middot; ONLINE</div>
        </div>
    </footer>

</div>

@section Scripts {
    <script src="~/js/testimonials.js" asp-append-version="true"></script>
}
