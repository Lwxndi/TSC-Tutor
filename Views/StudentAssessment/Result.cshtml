@* Views/StudentAssessment/Result.cshtml *@
@model Tutor_Manager.ViewModels.AssessmentViewmodels.AssessmentAttemptResultViewModel

@{
    ViewData["Title"] = "Assessment Result";
}

<div class="container mt-4">
    <h2>@Model.AssessmentTitle — Result</h2>

    <div class="alert alert-info">
        Total: <strong>@Model.TotalMarksAwarded / @Model.TotalPossibleMarks</strong>
        @if (Model.IsAutoSubmitted)
        {
            <span> (auto-submitted)</span>
        }
    </div>

    @foreach (var a in Model.Answers)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">@a.Marks mark(s) — awarded: @(a.MarksAwarded?.ToString() ?? "not marked")</h6>
                <p class="katex-content">@a.QuestionText</p>
                @if (!string.IsNullOrWhiteSpace(a.AiFeedback))
                {
                    <div class="border-start border-3 ps-2 text-muted">
                        <strong>Feedback:</strong> @a.AiFeedback
                    </div>
                }
            </div>
        </div>
    }

    <a asp-controller="StudentAssessment" asp-action="Index" class="btn btn-secondary">Back to Assessments</a>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/contrib/auto-render.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll('.katex-content').forEach(function (el) {
                renderMathInElement(el, {
                    delimiters: [
                        { left: "$$", right: "$$", display: true },
                        { left: "$", right: "$", display: false }
                    ],
                    throwOnError: false
                });
            });
        });
    </script>
}