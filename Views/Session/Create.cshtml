@model Tutor_Manager.ViewModels.CreateSessionViewModel
@using Tutor_Manager.Models.Enums
@{
    ViewData["Title"] = "Schedule Session";
}

<h2>Schedule Session</h2>
<p class="text-muted">
    @Model.SubjectName — Grade @((int)Model.Grade) — Tutor: @Model.TutorName<br />
    Teaching Days: @string.Join(", ", Model.OfferingTeachingDays) | Delivery: @Model.DeliveryMethod
</p>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="OfferingId" />

    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Date</label>
            <input asp-for="Date" type="date" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Start Time</label>
            <input asp-for="StartTime" type="time" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">End Time</label>
            <input asp-for="EndTime" type="time" class="form-control" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Schedule</button>
    <a asp-action="Index" asp-route-offeringId="@Model.OfferingId" class="btn btn-secondary mt-3">Cancel</a>
</form>