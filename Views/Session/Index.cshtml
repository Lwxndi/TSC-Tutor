@model Tutor_Manager.ViewModels.SessionIndexViewModel
@using Tutor_Manager.Models
@using Tutor_Manager.Models.Enums
@{
    ViewData["Title"] = "Sessions";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Sessions</h2>
    <div>
        <a asp-action="Create" class="btn btn-outline-primary">+ Create Session</a>
        <a asp-action="Generate" class="btn btn-primary">Generate Sessions</a>
    </div>
</div>

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-auto">
        <label class="form-label">Subject</label>
        <select name="SubjectId" class="form-select" asp-items="@(new SelectList(Model.Subjects, "SubjectId", "SubjectName", Model.Filter.SubjectId))">
            <option value="">All</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label">Grade</label>
        <select name="Grade" class="form-select">
            <option value="">All</option>
            <option value="@Grade.Grade10" selected="@(Model.Filter.Grade == Grade.Grade10)">Grade 10</option>
            <option value="@Grade.Grade11" selected="@(Model.Filter.Grade == Grade.Grade11)">Grade 11</option>
            <option value="@Grade.Grade12" selected="@(Model.Filter.Grade == Grade.Grade12)">Grade 12</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label">Tutor</label>
        <select name="TutorUserId" class="form-select" asp-items="@(new SelectList(Model.Tutors, "TutorUserId", "FullName", Model.Filter.TutorUserId))">
            <option value="">All</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label">Date</label>
        <select name="DateRange" class="form-select">
            <option value="Today" selected="@(Model.Filter.DateRange == "Today")">Today</option>
            <option value="ThisWeek" selected="@(Model.Filter.DateRange == "ThisWeek")">This Week</option>
            <option value="ThisMonth" selected="@(Model.Filter.DateRange == "ThisMonth")">This Month</option>
            <option value="All" selected="@(Model.Filter.DateRange == "All")">All Upcoming</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label">Status</label>
        <select name="Status" class="form-select">
            <option value="">All</option>
            <option value="@SessionStatus.Scheduled" selected="@(Model.Filter.Status == SessionStatus.Scheduled)">Scheduled</option>
            <option value="@SessionStatus.Cancelled" selected="@(Model.Filter.Status == SessionStatus.Cancelled)">Cancelled</option>
            <option value="@SessionStatus.Completed" selected="@(Model.Filter.Status == SessionStatus.Completed)">Completed</option>
        </select>
    </div>
    <div class="col-auto">
        <a asp-action="Calendar" class="btn btn-outline-secondary">Calendar View</a>
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
    </div>
</form>

@if (!Model.Sessions.Any())
{
    <p class="text-muted">No sessions match this filter.</p>
}
else
{
    DateTime? lastDate = null;
    foreach (var s in Model.Sessions)
    {
        if (lastDate == null || lastDate.Value.Date != s.Date.Date)
        {
            var label = s.Date.Date == DateTime.Today
                ? $"TODAY — {s.Date:dddd, d MMMM}"
                : $"{s.Date:dddd, d MMMM yyyy}";
            <h5 class="mt-4 text-muted">@label</h5>
            lastDate = s.Date;
        }

        <div class="card mb-2">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <strong>@s.StartTime.ToString(@"hh\:mm") – @s.EndTime.ToString(@"hh\:mm")</strong><br />
                    Grade @((int)s.Grade) @s.SubjectName<br />
                    <span class="text-muted">@s.TutorName</span>
                </div>
                <div>
                    @switch (s.Status)
                    {
                        case SessionStatus.Scheduled:
                            <span class="badge bg-primary">Scheduled</span>
                            break;
                        case SessionStatus.Cancelled:
                            <span class="badge bg-danger">Cancelled</span>
                            break;
                        case SessionStatus.Completed:
                            <span class="badge bg-success">Completed</span>
                            break;
                    }
                </div>
                <div>
                    <a asp-action="Details" asp-route-id="@s.SessionId" class="btn btn-sm btn-outline-primary">View</a>
                </div>
            </div>
        </div>
    }
}