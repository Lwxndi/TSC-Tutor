@model List<Tutor_Manager.ViewModels.Sessions.SessionListItemViewModel>
@using Tutor_Manager.Models.Enums
@{
    ViewData["Title"] = "Sessions";
    var offeringId = ViewBag.OfferingId;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Sessions — @(Model.Any() ? $"{Model.First().SubjectName} (Grade {(int)Model.First().Grade})" : "")</h2>
    <a asp-action="Create" asp-route-offeringId="@offeringId" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Schedule Session
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Date</th>
            <th>Time</th>
            <th>Tutor</th>
            <th>Status</th>
            <th>Link</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Date.ToString("dd MMM yyyy")</td>
                <td>@s.StartTime.ToString(@"hh\:mm") – @s.EndTime.ToString(@"hh\:mm")</td>
                <td>@s.TutorName</td>
                <td>
                    @switch (s.Status)
                    {
                        case SessionStatus.Scheduled:
                            <span class="badge bg-primary">Scheduled</span>
                            break;
                        case SessionStatus.Cancelled:
                            <span class="badge bg-danger">Cancelled</span>
                            break;
                        case SessionStatus.Completed:
                            <span class="badge bg-success">Completed</span>
                            break;
                    }
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(s.JitsiLink))
                    {
                        <a href="@s.JitsiLink" target="_blank">Join</a>
                    }
                    else
                    {
                        <span class="text-muted">In-person</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@s.SessionId" class="btn btn-sm btn-outline-primary">View</a>
                    @if (s.Status == SessionStatus.Scheduled)
                    {
                        <a asp-action="Cancel" asp-route-id="@s.SessionId" class="btn btn-sm btn-outline-danger">Cancel</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="Offering" asp-action="Index" class="btn btn-secondary">Back to Offerings</a>