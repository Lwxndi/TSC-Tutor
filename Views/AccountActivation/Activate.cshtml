@model Tutor_Manager.ViewModels.SetPasswordViewModel

@{
    ViewData["Title"] = "Activate Your Account";
}

<div class="container py-5" style="max-width: 500px;">
    <h2 class="mb-1">Welcome to The Science Community</h2>
    <p class="text-muted mb-4">Set a password to activate your tutor account.</p>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <form asp-controller="AccountActivation" asp-action="Activate" method="post">
        <input type="hidden" asp-for="Token" />

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" type="password" />
            <span asp-validation-for="Password" class="text-danger small"></span>
            <div class="form-text">At least 8 characters.</div>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">Activate My Account</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}