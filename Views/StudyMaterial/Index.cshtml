@* Views/StudyMaterial/Index.cshtml *@
@model List<Tutor_Manager.Models.StudyMaterial>

@{
    ViewData["Title"] = "My Study Material";
    var subjectGroups = Model.GroupBy(m => m.Subject).OrderBy(g => g.Key.SubjectName).ToList();
}

<div class="container mt-4">
    @Html.AntiForgeryToken()
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>My Study Material</h2>
        <a asp-controller="StudyMaterial" asp-action="Upload" class="btn btn-primary">Upload New Material</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (!Model.Any())
    {
        <p class="text-muted">You haven't uploaded any study material yet.</p>
    }
    else
    {
        <div class="row mb-3">
            <div class="col-md-4">
                <label for="subjectFilter" class="form-label">Filter by Subject</label>
                <select id="subjectFilter" class="form-select">
                    <option value="all">All Subjects</option>
                    @foreach (var group in subjectGroups)
                    {
                        <option value="subject-@group.Key.SubjectId">@group.Key.SubjectName</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label for="searchBox" class="form-label">Search</label>
                <input type="text" id="searchBox" class="form-control" placeholder="Search by title or topic..." />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="button" class="btn btn-outline-danger" id="deleteSelectedBtn" disabled>
                    Delete Selected (<span id="selectedCount">0</span>)
                </button>
            </div>
        </div>

        <div class="accordion" id="materialAccordion">
            @foreach (var group in subjectGroups)
            {
                var subjectPanelId = $"subject-{group.Key.SubjectId}";
                <div class="accordion-item material-group" data-subject-id="@subjectPanelId">
                    <h2 class="accordion-header">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@subjectPanelId">
                            @group.Key.SubjectName
                            <span class="badge bg-secondary ms-2">@group.Count() item(s)</span>
                        </button>
                    </h2>
                    <div id="collapse-@subjectPanelId" class="accordion-collapse collapse show" data-bs-parent="#materialAccordion">
                        <div class="accordion-body">
                            @foreach (var material in group.OrderByDescending(m => m.UploadedAt))
                            {
                                <div class="material-item d-flex align-items-start justify-content-between border-bottom py-2"
                                     data-title="@material.Title.ToLower()" data-topic="@material.TopicChapterLabel.ToLower()">
                                    <div class="d-flex align-items-start gap-2">
                                        <input type="checkbox" class="form-check-input mt-1 material-checkbox"
                                               data-id="@material.Id" data-title="@material.Title" data-subject="@group.Key.SubjectName" />
                                        <i class="bi bi-folder-fill text-warning fs-5"></i>
                                        <div>
                                            <div class="fw-semibold">@material.Title</div>
                                            <div class="text-muted small">@material.TopicChapterLabel</div>
                                            <div>
                                                @foreach (var file in material.Files)
                                                {
                                                    <span class="badge bg-light text-dark border me-1">@file.FileName</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <small class="text-muted text-nowrap">@material.UploadedAt.ToLocalTime().ToString("dd MMM yyyy")</small>
                                        <a asp-controller="StudyMaterial" asp-action="Edit" asp-route-id="@material.Id" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Delete confirmation modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Uncheck any item you want to keep, then confirm — only checked items will be deleted.</p>
                <ul id="deleteItemsList" class="list-group"></ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Confirm Delete</button>
            </div>
        </div>
    </div>
</div>

<form id="bulkDeleteForm" asp-controller="StudyMaterial" asp-action="BulkDelete" method="post" style="display:none;"></form>

@section Scripts {
    <script>
        const subjectFilter = document.getElementById('subjectFilter');
        const searchBox = document.getElementById('searchBox');
        const deleteSelectedBtn = document.getElementById('deleteSelectedBtn');
        const selectedCountSpan = document.getElementById('selectedCount');

        function applyFilters() {
            const selectedSubject = subjectFilter.value;
            const searchTerm = searchBox.value.toLowerCase().trim();

            document.querySelectorAll('.material-group').forEach(group => {
                const groupSubjectId = group.getAttribute('data-subject-id');
                const showGroup = selectedSubject === 'all' || selectedSubject === groupSubjectId;
                group.style.display = showGroup ? '' : 'none';
                if (!showGroup) return;

                let anyVisible = false;
                group.querySelectorAll('.material-item').forEach(item => {
                    const matchesSearch = searchTerm === '' ||
                        item.getAttribute('data-title').includes(searchTerm) ||
                        item.getAttribute('data-topic').includes(searchTerm);
                    item.style.display = matchesSearch ? '' : 'none';
                    if (matchesSearch) anyVisible = true;
                });

                if (searchTerm !== '') {
                    group.style.display = anyVisible ? '' : 'none';
                }
            });
        }

        subjectFilter.addEventListener('change', applyFilters);
        searchBox.addEventListener('input', applyFilters);

        function updateSelectedCount() {
            const checked = document.querySelectorAll('.material-checkbox:checked');
            selectedCountSpan.textContent = checked.length;
            deleteSelectedBtn.disabled = checked.length === 0;
        }

        document.querySelectorAll('.material-checkbox').forEach(cb => {
            cb.addEventListener('change', updateSelectedCount);
        });

        deleteSelectedBtn.addEventListener('click', function () {
            const checked = Array.from(document.querySelectorAll('.material-checkbox:checked'));
            const list = document.getElementById('deleteItemsList');
            list.innerHTML = '';

            checked.forEach(cb => {
                const li = document.createElement('li');
                li.className = 'list-group-item d-flex justify-content-between align-items-center';

                const checkWrap = document.createElement('div');
                checkWrap.className = 'form-check';
                const checkbox = document.createElement('input');
                checkbox.type = 'checkbox';
                checkbox.className = 'form-check-input me-2 modal-keep-checkbox';
                checkbox.checked = true;
                checkbox.dataset.id = cb.dataset.id;
                const label = document.createElement('label');
                label.className = 'form-check-label';
                label.textContent = `${cb.dataset.title} (${cb.dataset.subject})`;
                checkWrap.appendChild(checkbox);
                checkWrap.appendChild(label);

                li.appendChild(checkWrap);
                list.appendChild(li);
            });

            new bootstrap.Modal(document.getElementById('deleteConfirmModal')).show();
        });

        document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
            const idsToDelete = Array.from(document.querySelectorAll('.modal-keep-checkbox:checked'))
                .map(cb => cb.dataset.id);

            if (idsToDelete.length === 0) {
                alert('No items selected for deletion.');
                return;
            }

            const form = document.getElementById('bulkDeleteForm');
            form.innerHTML = '';

            const token = document.createElement('input');
            token.type = 'hidden';
            token.name = '__RequestVerificationToken';
            token.value = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            form.appendChild(token);

            idsToDelete.forEach(id => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'ids';
                input.value = id;
                form.appendChild(input);
            });

            form.submit();
        });
    </script>
}