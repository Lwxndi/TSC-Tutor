@model Tutor_Manager.ViewModels.TutorAssignment.ManageTutorViewModel
@{
    ViewData["Title"] = "Manage Tutor";
}

<h2>@Model.FullName</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<dl class="row">
    <dt class="col-sm-2">Qualification</dt>
    <dd class="col-sm-10">@Model.Qualification</dd>
    <dt class="col-sm-2">Bio</dt>
    <dd class="col-sm-10">@Model.Bio</dd>
    <dt class="col-sm-2">Current Assignments</dt>
    <dd class="col-sm-10">@(Model.CurrentAssignments.Any() ? string.Join(", ", Model.CurrentAssignments) : "None")</dd>
</dl>

<hr />

<h4>AI Recommendation</h4>

<form asp-action="GenerateForTutor" method="post" class="mb-3">
    <input type="hidden" name="tutorUserId" value="@Model.TutorUserId" />
    <button type="submit" class="btn btn-primary">Get AI Recommendation</button>

</form>

@if (Model.LatestRecommendation != null)
{
    <div class="card">
        <div class="card-body">
            <p class="text-muted small">Generated @Model.LatestRecommendation.DateGenerated.ToString("dd MMM yyyy, HH:mm")</p>
            <ul>
                @foreach (var r in Model.LatestRecommendation.Recommendations)
                {
                    <li>
                        @r.SubjectName — Grade @r.Grade
                        <form asp-action="Assign" method="post" class="d-inline">
                            <input type="hidden" name="tutorUserId" value="@Model.TutorUserId" />
                            <input type="hidden" name="subjectId" value="@r.SubjectId" />
                            <input type="hidden" name="grade" value="@(r.Grade + 10 - 10 == r.Grade ? (r.Grade) : r.Grade)" />
                            <button type="submit" class="btn btn-sm btn-outline-success">Apply</button>
                        </form>
                    </li>
                }
            </ul>
            <p><strong>Reasoning:</strong> @Model.LatestRecommendation.Reasoning</p>
        </div>
    </div>
}

<a asp-action="Index" class="btn btn-secondary mt-3">Back</a>