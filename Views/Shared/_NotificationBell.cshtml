@* Views/Shared/_NotificationBell.cshtml *@
<div class="notif-bell-wrapper">
    <button id="notifBellBtn" class="notif-bell-btn">
        <i class="bi bi-bell-fill"></i>
        <span id="notifBadge" class="notif-badge" style="display:none;">0</span>
    </button>

    <div id="notifPanel" class="notif-panel" style="display:none;">
        <div class="notif-panel-header">Notifications</div>
        <div id="notifList">Loading...</div>
    </div>
</div>

<style>
    .notif-bell-wrapper {
        position: relative;
        display: inline-block;
    }

    .notif-bell-btn {
        background: none;
        border: none;
        font-size: 1.3rem;
        cursor: pointer;
        position: relative;
        color: #2c3e50;
    }

    .notif-badge {
        position: absolute;
        top: -4px;
        right: -6px;
        background: #e63946;
        color: white;
        font-size: 0.65rem;
        padding: 2px 6px;
        border-radius: 999px;
        font-weight: 600;
    }

    .notif-panel {
        position: absolute;
        right: 0;
        top: 36px;
        width: 320px;
        background: white;
        border: 1px solid #e2e2e2;
        border-radius: 8px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.12);
        z-index: 1000;
        max-height: 400px;
        overflow-y: auto;
    }

    .notif-panel-header {
        padding: 12px 16px;
        font-weight: 600;
        border-bottom: 1px solid #eee;
    }

    .notif-item {
        padding: 12px 16px;
        border-bottom: 1px solid #f2f2f2;
        cursor: pointer;
    }

        .notif-item:hover {
            background: #f8f9fa;
        }

        .notif-item.unread {
            background: #eaf4f4;
        }

    .notif-title {
        font-weight: 600;
        font-size: 0.9rem;
        color: #2c3e50;
    }

    .notif-message {
        font-size: 0.85rem;
        color: #555;
        margin-top: 2px;
    }

    .notif-time {
        font-size: 0.75rem;
        color: #999;
        margin-top: 4px;
    }

    .notif-empty {
        padding: 20px;
        text-align: center;
        color: #999;
        font-size: 0.9rem;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const bellBtn = document.getElementById('notifBellBtn');
        const panel = document.getElementById('notifPanel');
        const list = document.getElementById('notifList');
        const badge = document.getElementById('notifBadge');

        async function loadNotifications() {
            const res = await fetch('/Notifications/Dropdown');
            const html = await res.text();
            list.innerHTML = html;

            const unreadCount = list.querySelectorAll('.notif-item.unread').length;
            if (unreadCount > 0) {
                badge.style.display = 'inline-block';
                badge.textContent = unreadCount;
            } else {
                badge.style.display = 'none';
            }

            // Mark as read when clicked
            list.querySelectorAll('.notif-item').forEach(item => {
                item.addEventListener('click', async () => {
                    const id = item.getAttribute('data-id');
                    await fetch('/Notifications/MarkAsRead?id=' + id, { method: 'POST' });
                    item.classList.remove('unread');
                    loadNotifications(); // refresh badge count
                });
            });
        }

        bellBtn.addEventListener('click', () => {
            const isOpen = panel.style.display === 'block';
            panel.style.display = isOpen ? 'none' : 'block';
            if (!isOpen) loadNotifications();
        });

        // close if clicking outside
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.notif-bell-wrapper')) {
                panel.style.display = 'none';
            }
        });

        // refresh badge count on page load too
        loadNotifications();
    });
</script>