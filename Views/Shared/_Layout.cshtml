<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tutor_Manager</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Tutor_Manager.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

    <style>
            :root {
                --sidebar-width: 260px;
                --sidebar-collapsed-width: 64px;
                --board: #2a211a;
                --board-2: #362b20;
                --paper: #efe9da;
                --ink: #2a211a;
                --ink-soft: #6b5c48;
                --hi: #a9835a;
                --hi-deep: #6b4f28;
                --line: rgba(42,33,26,.15);
                --line-chalk: rgba(239,233,218,.14);
                --board-soft: #cbbfa8;
                --grot: 'Space Grotesk', sans-serif;
                --mono: 'IBM Plex Mono', monospace;
            }

            body {
                display: flex;
                min-height: 100vh;
                font-family: var(--grot);
            }

            #sidebar {
                width: var(--sidebar-width);
                min-width: var(--sidebar-width);
                background-color: var(--board);
                color: var(--paper);
                transition: width 0.2s ease, min-width 0.2s ease;
                overflow: hidden;
                display: flex;
                flex-direction: column;

                /* pinned to the viewport */
                position: sticky;
                top: 0;
                height: 100vh;
                height: 100dvh;
                align-self: flex-start;
            }

                /* only the menu scrolls; header and Log Out stay put */
                #sidebar .sidebar-scroll {
                    flex: 1 1 auto;
                    min-height: 0;
                    overflow-y: auto;
                    overflow-x: hidden;
                }

                #sidebar.collapsed {
                    width: var(--sidebar-collapsed-width);
                    min-width: var(--sidebar-collapsed-width);
                }

                    #sidebar.collapsed .brand-text,
                    #sidebar.collapsed .nav-label,
                    #sidebar.collapsed .section-label,
                    #sidebar.collapsed .group-chevron {
                        display: none;
                    }

                #sidebar .sidebar-header {
                    padding: 1.1rem 1.2rem;
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    border-bottom: 1px solid var(--line-chalk);
                }

                #sidebar .brand-text {
                    font-family: var(--grot);
                    font-weight: 700;
                    font-size: .95rem;
                    white-space: nowrap;
                    overflow: hidden;
                }

                #sidebar .nav-link {
                    color: var(--board-soft);
                    padding: 0.55rem 1.2rem;
                    display: flex;
                    align-items: center;
                    gap: 0.7rem;
                    white-space: nowrap;
                    font-size: .85rem;
                }

                    #sidebar .nav-link:hover,
                    #sidebar .nav-link.active {
                        color: var(--paper);
                        background-color: rgba(239,233,218,.05);
                    }

                    #sidebar .nav-link.active {
                        border-right: 2px solid var(--hi);
                        background-color: rgba(169,131,90,.14);
                    }

                    #sidebar .nav-link i {
                        font-size: .95rem;
                        min-width: 1.1rem;
                        text-align: center;
                    }

                #sidebar .section-label {
                    padding: 0.9rem 1.2rem 0.25rem;
                    font-family: var(--mono);
                    font-size: 0.68rem;
                    text-transform: uppercase;
                    letter-spacing: 0.08em;
                    color: var(--hi);
                }

                #sidebar .nav-group-head {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    padding: 0.9rem 1.2rem 0.25rem;
                    cursor: pointer;
                }

                #sidebar .group-chevron {
                    font-size: .68rem;
                    color: var(--board-soft);
                    transition: transform .15s ease;
                }

                #sidebar .nav-group.collapsed .group-chevron {
                    transform: rotate(-90deg);
                }

                #sidebar .nav-group.collapsed .nav-group-items {
                    display: none;
                }

            #sidebarToggle {
                background: none;
                border: none;
                color: var(--paper);
                cursor: pointer;
                font-size: 1.1rem;
            }

            #mainContent {
                flex: 1;
                display: flex;
                flex-direction: column;
                min-width: 0;
            }

            #topbar {
                border-bottom: 1px solid #dee2e6;
                padding: 0.75rem 1.25rem;
                background: #fff;
            }
    </style>
</head>
<body>

    @{
        // Logged-out users keep the classic Home link. Logged-in users keep the
        // same house icon, but it now takes them straight to their own dashboard
        // instead of the public homepage.
        var isAuthed = User.Identity != null && User.Identity.IsAuthenticated;
        var homeController = "Home";
        var homeAction = "Index";

        if (isAuthed)
        {
            if (User.IsInRole("Admin"))
            {
                homeController = "Administrators";
                homeAction = "Dashboard";
            }
            else if (User.IsInRole("Tutor"))
            {
                homeController = "Tutors";
                homeAction = "Dashboard";
            }
            else if (User.IsInRole("Parent"))
            {
                homeController = "Parents";
                homeAction = "Dashboard";
            }
            else if (User.IsInRole("Learner"))
            {
                homeController = "Learners";
                homeAction = "Dashboard";
            }
        }
    }

    <nav id="sidebar">
        <div class="sidebar-header">
            <span class="brand-text">Tutor_Manager</span>
            <button id="sidebarToggle" title="Toggle sidebar">
                <i class="bi bi-list"></i>
            </button>
        </div>

        <div class="sidebar-scroll py-2">
            <a class="nav-link" asp-controller="@homeController" asp-action="@homeAction" data-bs-toggle="tooltip" data-bs-placement="right" title="Home">
                <i class="bi bi-house-door"></i> <span class="nav-label">Home</span>
            </a>

            @if (isAuthed)
            {
                @if (User.IsInRole("Admin"))
                {
                    <div class="nav-group">
                        <div class="nav-group-head" onclick="toggleNavGroup(this)">
                            <span class="section-label" style="padding:0;">People</span>
                            <i class="bi bi-chevron-down group-chevron"></i>
                        </div>
                        <div class="nav-group-items">
                            <a class="nav-link" href="#" data-bs-toggle="tooltip" data-bs-placement="right" title="Learners">
                                <i class="bi bi-mortarboard"></i> <span class="nav-label">Learners</span>
                            </a>
                            <a class="nav-link" href="#" data-bs-toggle="tooltip" data-bs-placement="right" title="Guardians">
                                <i class="bi bi-person-heart"></i> <span class="nav-label">Guardians</span>
                            </a>
                            <a class="nav-link" href="#" data-bs-toggle="tooltip" data-bs-placement="right" title="Tutors">
                                <i class="bi bi-journal-bookmark"></i> <span class="nav-label">Tutors</span>
                            </a>
                            <a class="nav-link" asp-controller="AdminManagement" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Administrators">
                                <i class="bi bi-person-badge"></i> <span class="nav-label">Administrators</span>
                            </a>
                        </div>
                    </div>

                    <div class="nav-group">
                        <div class="nav-group-head" onclick="toggleNavGroup(this)">
                            <span class="section-label" style="padding:0;">Tutor Recruitment</span>
                            <i class="bi bi-chevron-down group-chevron"></i>
                        </div>
                        <div class="nav-group-items">
                            <a class="nav-link" asp-controller="AdminTutorApplication" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Tutor Applications">
                                <i class="bi bi-file-earmark-person"></i> <span class="nav-label">Tutor Applications</span>
                            </a>
                            @* <a class="nav-link" href="#" data-bs-toggle="tooltip" data-bs-placement="right" title="Vetting">
                                <i class="bi bi-shield-check"></i> <span class="nav-label">Vetting</span>
                            </a> *@
                        </div>
                    </div>

                    <div class="nav-group">
                        <div class="nav-group-head" onclick="toggleNavGroup(this)">
                            <span class="section-label" style="padding:0;">Teaching</span>
                            <i class="bi bi-chevron-down group-chevron"></i>
                        </div>
                        <div class="nav-group-items">
                            <a class="nav-link" asp-controller="Academic" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Academic Setup">
                                <i class="bi bi-diagram-3"></i> <span class="nav-label">Academic Setup</span>
                            </a>
                            <a class="nav-link" asp-controller="TutorManagement" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Tutor Management">
                                <i class="bi bi-people"></i> <span class="nav-label">Tutor Management</span>
                            </a>
                            <a class="nav-link" asp-controller="TutorAssignment" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Tutor Assignments">
                                <i class="bi bi-clipboard-check"></i> <span class="nav-label">Tutor Assignments</span>
                            </a>
                            <a class="nav-link" asp-controller="Offering" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Offerings">
                                <i class="bi bi-collection"></i> <span class="nav-label">Offerings</span>
                            </a>
                            <a class="nav-link" asp-controller="Session" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Sessions">
                                <i class="bi bi-calendar-week"></i> <span class="nav-label">Sessions</span>
                            </a>
                        </div>
                    </div>

                    <div class="nav-group collapsed">
                        <div class="nav-group-head" onclick="toggleNavGroup(this)">
                            <span class="section-label" style="padding:0;">Learners</span>
                            <i class="bi bi-chevron-down group-chevron"></i>
                        </div>
                        <div class="nav-group-items">
                            <a class="nav-link" asp-controller="AdminEnrollment" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Enrolments">
                                <i class="bi bi-clipboard-plus"></i> <span class="nav-label">Enrolments</span>
                            </a>
                            <a class="nav-link" href="#" data-bs-toggle="tooltip" data-bs-placement="right" title="Attendance">
                                <i class="bi bi-calendar-check"></i> <span class="nav-label">Attendance</span>
                            </a>

                            <a asp-controller="AdminAttendance" asp-action="Edit" asp-route-sessionId="@Model.SessionId" class="btn btn-outline-secondary">
                              <i class="bi bi-calendar-check"></i> Attendance
                            </a>
                        </div>
                    </div>

                    <div class="nav-group collapsed">
                        <div class="nav-group-head" onclick="toggleNavGroup(this)">
                            <span class="section-label" style="padding:0;">Payments</span>
                            <i class="bi bi-chevron-down group-chevron"></i>
                        </div>
                        <div class="nav-group-items">
                            <a class="nav-link" href="#" data-bs-toggle="tooltip" data-bs-placement="right" title="Overview">
                                <i class="bi bi-graph-up"></i> <span class="nav-label">Overview</span>
                            </a>
                            <a class="nav-link" asp-controller="AdminPayment" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Fees / Invoices">
                                <i class="bi bi-receipt"></i> <span class="nav-label">Fees / Invoices</span>
                            </a>
                            @* <a class="nav-link" href="#" data-bs-toggle="tooltip" data-bs-placement="right" title="Transactions">
                                <i class="bi bi-arrow-left-right"></i> <span class="nav-label">Transactions</span>
                            </a> *@
                            <a class="nav-link" href="#" data-bs-toggle="tooltip" data-bs-placement="right" title="Outstanding">
                                <i class="bi bi-exclamation-circle"></i> <span class="nav-label">Outstanding</span>
                            </a>
                            @* <a class="nav-link" href="#" data-bs-toggle="tooltip" data-bs-placement="right" title="Payment Verification">
                                <i class="bi bi-check2-circle"></i> <span class="nav-label">Payment Verification</span>
                            </a>
                            <a class="nav-link" href="#" data-bs-toggle="tooltip" data-bs-placement="right" title="Refunds">
                                <i class="bi bi-arrow-counterclockwise"></i> <span class="nav-label">Refunds</span>
                            </a> *@
                        </div>
                    </div>

                    <div class="nav-group collapsed">
                        <div class="nav-group-head" onclick="toggleNavGroup(this)">
                            <span class="section-label" style="padding:0;">Academic</span>
                            <i class="bi bi-chevron-down group-chevron"></i>
                        </div>
                        <div class="nav-group-items">
                            <a class="nav-link" href="#" data-bs-toggle="tooltip" data-bs-placement="right" title="Assessments">
                                <i class="bi bi-pencil-square"></i> <span class="nav-label">Assessments</span>
                            </a>
                            <a class="nav-link" href="#" data-bs-toggle="tooltip" data-bs-placement="right" title="Progress">
                                <i class="bi bi-graph-up-arrow"></i> <span class="nav-label">Progress</span>
                            </a>
                        </div>
                    </div>

                    <div class="nav-group collapsed">
                        <div class="nav-group-head" onclick="toggleNavGroup(this)">
                            <span class="section-label" style="padding:0;">Communication</span>
                            <i class="bi bi-chevron-down group-chevron"></i>
                        </div>
                        <div class="nav-group-items">
                            <a class="nav-link" href="#" data-bs-toggle="tooltip" data-bs-placement="right" title="Notifications">
                                <i class="bi bi-bell"></i> <span class="nav-label">Notifications</span>
                            </a>
                            <a class="nav-link" href="#" data-bs-toggle="tooltip" data-bs-placement="right" title="Announcements">
                                <i class="bi bi-megaphone"></i> <span class="nav-label">Announcements</span>
                            </a>

                             <a class="nav-link" href="#" data-bs-toggle="tooltip" data-bs-placement="right" title="Reports">
                                    <i class="bi bi-bar-chart"></i> <span class="nav-label">Reports</span>
                            </a>

                        </div>
                    </div>

                   
                }

                @if (User.IsInRole("Tutor"))
                {
                    <a class="nav-link" asp-controller="TutorEnrollment" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="My Classes">
                        <i class="bi bi-people"></i> <span class="nav-label">My Classes</span>
                    </a>

                    <div class="section-label">Tutor</div>
                    <a class="nav-link" asp-controller="Tutors" asp-action="Dashboard" data-bs-toggle="tooltip" data-bs-placement="right" title="My Tutor Profile">
                        <i class="bi bi-mortarboard"></i> <span class="nav-label">My Tutor Profile</span>
                    </a>
                    <a class="nav-link" asp-controller="TutorSession" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="My Sessions">
                        <i class="bi bi-calendar-check"></i> <span class="nav-label">My Sessions</span>
                    </a>
                    <a class="nav-link" asp-controller="Session" asp-action="MyTimetable" data-bs-toggle="tooltip" data-bs-placement="right" title="My Timetable">
                        <i class="bi bi-calendar3"></i> <span class="nav-label">My Timetable</span>
                    </a>
                    <a class="nav-link" asp-controller="StudyMaterial" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Study Material">
                        <i class="bi bi-file-earmark-text"></i> <span class="nav-label">Study Material</span>
                    </a>
                    <a class="nav-link" asp-controller="Quiz" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Quizzes">
                        <i class="bi bi-patch-question"></i> <span class="nav-label">Quizzes</span>
                    </a>
                    <a class="nav-link" asp-controller="Assessment" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Assessments">
                        <i class="bi bi-file-earmark-check"></i> <span class="nav-label">Assessments</span>
                    </a>
                }

                @if (User.IsInRole("Parent"))
                {
                    <a class="nav-link" asp-controller="GuardianEnrollment" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Enrolments">
                        <i class="bi bi-clipboard-plus"></i> <span class="nav-label">My Learners' Enrolments</span>
                    </a>
                    <a class="nav-link" asp-controller="GuardianPayment" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Invoices">
                        <i class="bi bi-receipt"></i> <span class="nav-label">My Invoices</span>
                    </a>
                    <a class="nav-link" asp-controller="Session" asp-action="MyChildrensTimetable" data-bs-toggle="tooltip" data-bs-placement="right" title="My Children Timetable">
                        <i class="bi bi-calendar-check"></i> <span class="nav-label">My Sessions</span>
                    </a>
                }

                @if (User.IsInRole("Learner"))
                {
                    <a class="nav-link" asp-controller="Session" asp-action="LearnerTimetable" data-bs-toggle="tooltip" data-bs-placement="right" title="My Sessions">
                        <i class="bi bi-calendar-check"></i> <span class="nav-label">My Sessions</span>
                    </a>
                    <a class="nav-link" asp-controller="StudentMaterials" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Study Material">
                        <i class="bi bi-file-earmark-text"></i> <span class="nav-label">Study Material</span>
                    </a>
                    <a class="nav-link" asp-controller="StudentQuiz" asp-action="Results" ...>
                          <i class="bi bi-clipboard-data"></i> <span class="nav-label">My Quiz Results</span>
                    </a>

                    <a class="nav-link" asp-controller="StudentQuiz" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Quizzes">
                        <i class="bi bi-patch-question"></i> <span class="nav-label">Quizzes</span>
                    </a>
                    <a class="nav-link" asp-controller="StudentAssessment" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Assessments">
                        <i class="bi bi-file-earmark-check"></i> <span class="nav-label">Assessments</span>
                    </a>
                    <a class="nav-link" href="#" data-bs-toggle="tooltip" data-bs-placement="right" title="Enrolments (coming soon)">
                        <i class="bi bi-clipboard-plus"></i> <span class="nav-label">Enrolments</span>
                    </a>
                }
            }
            else
            {
                <div class="section-label">Account</div>
                <a class="nav-link" asp-controller="Home" asp-action="RegisterLearner" data-bs-toggle="tooltip" data-bs-placement="right" title="Learner Register">
                    <i class="bi bi-person-plus"></i> <span class="nav-label">Learner Register</span>
                </a>
                <a class="nav-link" asp-controller="TutorApplication" asp-action="PersonalInfo" data-bs-toggle="tooltip" data-bs-placement="right" title="Apply to Tutor">
                    <i class="bi bi-mortarboard"></i> <span class="nav-label">Apply to Tutor</span>
                </a>
                <a class="nav-link" asp-controller="Home" asp-action="Login" data-bs-toggle="tooltip" data-bs-placement="right" title="Log In">
                    <i class="bi bi-box-arrow-in-right"></i> <span class="nav-label">Log In</span>
                </a>
            }
        </div>

        <div class="border-top border-secondary py-2">
            @if (isAuthed)
            {
                <form asp-controller="Home" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="nav-link border-0 bg-transparent w-100 text-start" data-bs-toggle="tooltip" data-bs-placement="right" title="Log Out">
                        <i class="bi bi-box-arrow-right"></i> <span class="nav-label">Log Out</span>
                    </button>
                </form>
            }
        </div>
    </nav>

    <div id="mainContent">
        <div id="topbar" class="d-flex justify-content-between align-items-center">
            <span class="text-muted small">@ViewData["Title"]</span>
            @if (isAuthed)
            {
                <div class="d-flex align-items-center gap-3">
                    @await Html.PartialAsync("_NotificationBell")
                    <span class="text-muted small">Signed in as @User.Identity.Name</span>
                </div>
            }
        </div>

        <div class="container-fluid py-3">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="border-top footer text-muted mt-auto">
            <div class="container-fluid py-2">
                &copy; 2026 - Tutor_Manager - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
            const sidebar = document.getElementById("sidebar");
            const toggleBtn = document.getElementById("sidebarToggle");

            if (localStorage.getItem("sidebarCollapsed") === "true") {
                sidebar.classList.add("collapsed");
            }

            toggleBtn.addEventListener("click", function() {
                sidebar.classList.toggle("collapsed");
                localStorage.setItem("sidebarCollapsed", sidebar.classList.contains("collapsed"));
            });

            document.addEventListener("DOMContentLoaded", function() {
                const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
                [...tooltipTriggerList].map(el => new bootstrap.Tooltip(el));
            });

            function toggleNavGroup(headEl) {
                const group = headEl.closest(".nav-group");
                if (!group) return;

                const isCollapsed = group.classList.contains("collapsed");

                document.querySelectorAll("#sidebar .nav-group").forEach(function (g) {
                    g.classList.add("collapsed");
                });

                if (isCollapsed) {
                    group.classList.remove("collapsed");
                }
            }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
