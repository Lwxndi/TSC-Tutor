@model Tutor_Manager.ViewModels.TutorApplication.TutorApplicationDocumentUploadViewModel

@{
    ViewData["Title"] = "Tutor Application — Supporting Documents";
}

<div class="container py-4" style="max-width: 700px;">
    <h2 class="mb-1">Supporting Documents</h2>
    <p class="text-muted mb-4">Upload the documents below. Accepted formats: PDF, JPG, PNG. Max 5MB per file.</p>

    @await Html.PartialAsync("_StepProgress", (6, string.Empty))

    <form asp-controller="TutorApplication" asp-action="Documents" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="ApplicationId" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        @{
            var slots = new (string Key, string Label, string Requirement, string InputName)[]
              {
                ("CV", "CV", "Required", nameof(Model.CV)),
                ("Transcript", "Academic Transcript / Umalusi Results / School Report", "Required", nameof(Model.Transcript)),
                ("Certificate", "Qualification Certificate", "Recommended", nameof(Model.Certificate)),
                ("TeachingCertificate", "Teaching/Tutoring Certificate", "Optional", nameof(Model.TeachingCertificate)),
                ("ReferenceLetter", "Reference Letter", "Optional", nameof(Model.ReferenceLetter)),
                ("Other", "Other Supporting Document", "Optional", nameof(Model.Other))
              };
        }

        @foreach (var slot in slots)
        {
            @if (slot.Key == "Other")
            {
                <div class="form-text">e.g. ID document, proof of address, additional certifications.</div>
            }
            var alreadyUploaded = Model.AlreadyUploadedFileNames.ContainsKey(slot.Key);
            var badgeClass = slot.Requirement == "Required" ? "text-bg-danger"
                            : slot.Requirement == "Recommended" ? "text-bg-warning"
                            : "text-bg-secondary";

            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label mb-0 fw-bold">@slot.Label</label>
                        <span class="badge @badgeClass">@slot.Requirement</span>
                    </div>

                    @if (alreadyUploaded)
                    {
                        <div class="text-success small mb-2">
                            ✓ Uploaded: @Model.AlreadyUploadedFileNames[slot.Key]
                        </div>
                    }

                    <input type="file" class="form-control" name="@slot.InputName" accept=".pdf,.jpg,.jpeg,.png" />
                    <span asp-validation-for="@slot.InputName" class="text-danger small"></span>

                    @if (alreadyUploaded)
                    {
                        <div class="form-text">Uploading a new file will replace the one above.</div>
                    }
                </div>
            </div>
        }

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Strengths" asp-route-id="@Model.ApplicationId" class="btn btn-outline-secondary">Back</a>
            <button type="submit" class="btn btn-primary">Next: Review</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}