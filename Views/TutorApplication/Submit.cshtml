@model Tutor_Manager.ViewModels.TutorApplication.TutorApplicationSubmitViewModel

@{
    ViewData["Title"] = "Tutor Application — Submit";
}

<div class="container py-4" style="max-width: 700px;">
    <h2 class="mb-1">Final Step</h2>
    <p class="text-muted mb-4">Please confirm below to submit your application.</p>

    @await Html.PartialAsync("_StepProgress", (8, string.Empty))

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <form asp-controller="TutorApplication" asp-action="Submit" method="post">
        <input type="hidden" asp-for="ApplicationId" />
        <input type="hidden" asp-for="ConsentVersion" value="1.0" />

        <!-- The ONLY input the server ever binds ConsentGiven from -->
        <input type="hidden" id="ConsentGivenHidden" name="ConsentGiven" value="@(Model.ConsentGiven ? "true" : "false")" />

        <div class="card mb-4">
            <div class="card-body">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="ConsentCheckbox" checked="@Model.ConsentGiven" />
                    <label class="form-check-label" for="ConsentCheckbox">
                        I consent to The Science Community collecting and processing the personal
                        information and supporting documents provided in this application for the
                        purpose of evaluating my application to become a tutor.
                    </label>
                </div>
                <span id="consentError" class="text-danger small d-block mt-2">
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState["ConsentGiven"]?.Errors.Count > 0)
                    {
                        @ViewData.ModelState["ConsentGiven"].Errors[0].ErrorMessage
                    }
                </span>
            </div>
        </div>

        <div class="alert alert-info">
            Are you sure all the information you've provided is correct? You can still go back and
            edit your application before submitting.
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Review" asp-route-id="@Model.ApplicationId" class="btn btn-outline-secondary">Back to Review</a>
            <button type="submit" class="btn btn-success">Confirm & Submit Application</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const checkbox = document.getElementById("ConsentCheckbox");
        const hidden = document.getElementById("ConsentGivenHidden");
        const errorSpan = document.getElementById("consentError");

        checkbox.addEventListener("change", function() {
            hidden.value = this.checked ? "true" : "false";
            if (this.checked) {
                errorSpan.textContent = "";
            }
        });
    </script>
}