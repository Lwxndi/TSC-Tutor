@* Views/Assessment/Index.cshtml *@
@model List<Tutor_Manager.Models.Assessment>

@{
    ViewData["Title"] = "My Assessments";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>My Assessments</h2>
        <a asp-controller="Assessment" asp-action="Create" class="btn btn-primary">Create New Assessment</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (!Model.Any())
    {
        <p class="text-muted">You haven't created any assessments yet.</p>
    }
    else
    {
        <!-- Standalone bulk-delete form — NOT wrapping the table. JS injects the
             selected ids into this form's hidden inputs right before it submits,
             so it never nests inside (or around) the per-row forms below. -->
        <form asp-controller="Assessment" asp-action="BulkDelete" method="post" id="bulkDeleteForm"
              onsubmit="return confirm('Delete all selected assessments?');">
            @Html.AntiForgeryToken()
            <div id="bulkDeleteIdsContainer"></div>
        </form>

        <div class="mb-2">
            <input type="checkbox" id="selectAll" /> <label for="selectAll">Select all</label>
            <button type="button" id="deleteSelectedBtn" class="btn btn-sm btn-outline-danger ms-2">Delete Selected</button>
        </div>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th></th>
                    <th>Title</th>
                    <th>Subject</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td><input type="checkbox" value="@a.Id" class="row-checkbox" /></td>
                        <td>@a.Title</td>
                        <td>@a.Subject.SubjectName</td>
                        <td>@a.DueDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @a.Status
                            @if (a.Status != Tutor_Manager.Models.AssessmentGenerationStatus.NotGenerated)
                            {
                                <span class="badge bg-secondary">Locked</span>
                            }
                        </td>
                        <td>
                            @if (a.Status == Tutor_Manager.Models.AssessmentGenerationStatus.NotGenerated)
                            {
                                <a asp-controller="Assessment" asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <form asp-controller="Assessment" asp-action="Generate" asp-route-id="@a.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Generate</button>
                                </form>
                            }
                            else
                            {
                                <a asp-controller="Assessment" asp-action="Review" asp-route-assessmentId="@a.Id" class="btn btn-sm btn-outline-secondary">Review</a>
                            }
                            <form asp-controller="Assessment" asp-action="Delete" asp-route-id="@a.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this assessment?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('selectAll')?.addEventListener('change', function () {
            document.querySelectorAll('.row-checkbox').forEach(cb => cb.checked = this.checked);
        });

        document.getElementById('deleteSelectedBtn')?.addEventListener('click', function () {
            var checked = Array.from(document.querySelectorAll('.row-checkbox:checked'));
            if (checked.length === 0) {
                alert('Select at least one assessment first.');
                return;
            }

            var container = document.getElementById('bulkDeleteIdsContainer');
            container.innerHTML = '';
            checked.forEach(function (cb) {
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'ids';
                input.value = cb.value;
                container.appendChild(input);
            });

            document.getElementById('bulkDeleteForm').requestSubmit();
        });
    </script>
}