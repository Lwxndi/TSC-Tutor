@model Tutor_Manager.ViewModels.QuizzViewmodels.QuizQuestionEditViewModel
@using Tutor_Manager.Models

@{
    ViewData["Title"] = Model.Id == 0 ? "Add Question" : "Edit Question";
    var isNew = Model.Id == 0;
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <form asp-controller="Quiz" asp-action="@(isNew ? "AddQuestion" : "EditQuestion")" method="post" id="questionForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="QuizId" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="QuestionType" class="form-label">Question Type</label>
            <select asp-for="QuestionType" class="form-select" id="typeSelect"
                    asp-items="Html.GetEnumSelectList<QuizQuestionType>()"></select>
            <div class="form-text text-warning" id="typeChangeWarning" style="display:none;">
                Switching type will clear the fields specific to the current type (options, or the True/False answer, or marking guidance) — anything not relevant to the new type will be lost when you save.
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="QuestionText" class="form-label">Question Text</label>
            <textarea asp-for="QuestionText" class="form-control" rows="3"></textarea>
            <div class="form-text">You can use LaTeX for equations — <code>$x^2 + 2x + 1$</code> for inline, <code>$$...$$</code> for block.</div>
            <span asp-validation-for="QuestionText" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Marks" class="form-label">Marks</label>
            <input asp-for="Marks" type="number" class="form-control" min="1" max="100" style="max-width:150px;" />
            <span asp-validation-for="Marks" class="text-danger"></span>
        </div>

        <div id="optionsSection" class="mb-3" style="display:none;">
            <label class="form-label">Options</label>
            <div id="optionsList">
                @for (int i = 0; i < Model.Options.Count; i++)
                {
                    <div class="input-group mb-2 option-row">
                        <div class="input-group-text">
                            <input type="checkbox" name="Options[@i].IsCorrect" value="true" checked="@(Model.Options[i].IsCorrect ? "checked" : null)" />
                            <input type="hidden" name="Options[@i].IsCorrect" value="false" />
                        </div>
                        <input type="hidden" name="Options[@i].Id" value="@Model.Options[i].Id" />
                        <input type="text" name="Options[@i].OptionText" value="@Model.Options[i].OptionText" class="form-control" placeholder="Option text" />
                        <button type="button" class="btn btn-outline-danger remove-option-btn">&times;</button>
                    </div>
                }
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="addOptionBtn">Add Option</button>
            <div class="form-text">Check the box next to each correct option. Multiple choice (single) needs exactly one checked; multiple choice (multiple) needs at least one checked.</div>
        </div>

        <div id="trueFalseSection" class="mb-3" style="display:none;">
            <label class="form-label d-block">Correct Answer</label>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="CorrectBoolAnswer" value="true" id="boolTrue" />
                <label class="form-check-label" for="boolTrue">True</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="CorrectBoolAnswer" value="false" id="boolFalse" />
                <label class="form-check-label" for="boolFalse">False</label>
            </div>
        </div>

        <div id="markingGuidanceSection" class="mb-3" style="display:none;">
            <label asp-for="MarkingGuidance" class="form-label">Marking Guidance</label>
            <textarea asp-for="MarkingGuidance" class="form-control" rows="4"></textarea>
            <div class="form-text">Describes how this question should be marked. LaTeX supported.</div>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-controller="Quiz" asp-action="Review" asp-route-quizId="@Model.QuizId" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const typeSelect = document.getElementById('typeSelect');
        const optionsSection = document.getElementById('optionsSection');
        const trueFalseSection = document.getElementById('trueFalseSection');
        const markingGuidanceSection = document.getElementById('markingGuidanceSection');
        const typeChangeWarning = document.getElementById('typeChangeWarning');
        const optionsList = document.getElementById('optionsList');
        const addOptionBtn = document.getElementById('addOptionBtn');

        const originalType = typeSelect.value;
        let optionIndex = @Model.Options.Count;
        const optionTypes = ['MultipleChoiceSingle', 'MultipleChoiceMultiple'];

        function updateSections() {
            const selected = typeSelect.value;
            optionsSection.style.display = optionTypes.includes(selected) ? '' : 'none';
            trueFalseSection.style.display = selected === 'TrueFalse' ? '' : 'none';
            markingGuidanceSection.style.display = ['ShortAnswer', 'Essay', 'NumericEquation'].includes(selected) ? '' : 'none';
            typeChangeWarning.style.display = (selected !== originalType) ? '' : 'none';
        }

        typeSelect.addEventListener('change', updateSections);
        updateSections();

        addOptionBtn.addEventListener('click', function () {
            const row = document.createElement('div');
            row.className = 'input-group mb-2 option-row';
            row.innerHTML = `
                <div class="input-group-text">
                    <input type="checkbox" name="Options[${optionIndex}].IsCorrect" value="true" />
                    <input type="hidden" name="Options[${optionIndex}].IsCorrect" value="false" />
                </div>
                <input type="hidden" name="Options[${optionIndex}].Id" value="0" />
                <input type="text" name="Options[${optionIndex}].OptionText" class="form-control" placeholder="Option text" />
                <button type="button" class="btn btn-outline-danger remove-option-btn">&times;</button>
            `;
            optionsList.appendChild(row);
            optionIndex++;
            attachRemoveHandler(row.querySelector('.remove-option-btn'));
        });

        function attachRemoveHandler(btn) {
            btn.addEventListener('click', function () {
                this.closest('.option-row').remove();
            });
        }
        document.querySelectorAll('.remove-option-btn').forEach(attachRemoveHandler);

        // This is the required warning before a type change loses data (Decision Log point 1).
        document.getElementById('questionForm').addEventListener('submit', function (e) {
            if (typeSelect.value !== originalType) {
                const proceed = confirm('Changing the question type will clear fields specific to the previous type. Continue?');
                if (!proceed) {
                    e.preventDefault();
                }
            }
        });
    </script>
}