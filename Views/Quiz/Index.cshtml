@model List<Tutor_Manager.Models.Quiz>
@using Tutor_Manager.Models

@{
    ViewData["Title"] = "My Quizzes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>My Quizzes</h2>
        <a asp-controller="Quiz" asp-action="Create" class="btn btn-primary">Create New Quiz</a>
    </div>

    @Html.AntiForgeryToken()

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (!Model.Any())
    {
        <p class="text-muted">You haven't created any quizzes yet.</p>
    }
    else
    {
        <div class="row mb-3">
            <div class="col-md-6">
                <label for="searchBox" class="form-label">Search</label>
                <input type="text" id="searchBox" class="form-control" placeholder="Search by title or study material..." />
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <button type="button" class="btn btn-outline-danger" id="deleteSelectedBtn" disabled>
                    Delete Selected (<span id="selectedCount">0</span>)
                </button>
            </div>
        </div>

        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th></th>
                    <th>Title</th>
                    <th>Study Material</th>
                    <th>Opens</th>
                    <th>Closes</th>
                    <th>Duration</th>
                    <th>Max Attempts</th>
                    <th>Audience</th>
                    <th>Questions</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var quiz in Model)
                {
                    var isOpen = quiz.OpenAt <= DateTime.UtcNow;
                    <tr class="quiz-row" data-title="@quiz.Title.ToLower()" data-material="@quiz.StudyMaterial.Title.ToLower()">
                        <td>
                            <input type="checkbox" class="form-check-input quiz-checkbox"
                                   data-id="@quiz.Id" data-title="@quiz.Title" />
                        </td>
                        <td>@quiz.Title</td>
                        <td>@quiz.StudyMaterial.Title</td>
                        <td>@quiz.OpenAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                        <td>@quiz.CloseAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                        <td>@quiz.DurationMinutes min</td>
                        <td>@quiz.MaxAttempts</td>
                        <td>@quiz.AudienceType</td>
                        <td>
                            @if (quiz.Status == QuizGenerationStatus.NotGenerated)
                            {
                                <span class="badge bg-secondary">Not generated</span>
                            }
                            else if (quiz.Status == QuizGenerationStatus.Generated)
                            {
                                <span class="badge bg-warning text-dark">Generated — needs review</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Confirmed</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            @if (!isOpen)
                            {
                                <a asp-controller="Quiz" asp-action="Edit" asp-route-id="@quiz.Id" class="btn btn-sm btn-outline-secondary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            }
                            else
                            {
                                <span class="badge bg-secondary" title="Already open — locked">Locked</span>
                            }

                            @if (quiz.Status == QuizGenerationStatus.NotGenerated)
                            {
                                <form asp-controller="Quiz" asp-action="Generate" asp-route-id="@quiz.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Generate</button>
                                </form>
                            }
                            else
                            {
                                <a asp-controller="Quiz" asp-action="Review" asp-route-quizId="@quiz.Id" class="btn btn-sm btn-outline-info">Review</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Uncheck any item you want to keep, then confirm — only checked items will be deleted.</p>
                <ul id="deleteItemsList" class="list-group"></ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Confirm Delete</button>
            </div>
        </div>
    </div>
</div>

<form id="bulkDeleteForm" asp-controller="Quiz" asp-action="BulkDelete" method="post" style="display:none;"></form>

@section Scripts {
    <script>
        const searchBox = document.getElementById('searchBox');
        const deleteSelectedBtn = document.getElementById('deleteSelectedBtn');
        const selectedCountSpan = document.getElementById('selectedCount');

        function applyFilters() {
            const searchTerm = searchBox.value.toLowerCase().trim();
            document.querySelectorAll('.quiz-row').forEach(row => {
                const matches = searchTerm === '' ||
                    row.getAttribute('data-title').includes(searchTerm) ||
                    row.getAttribute('data-material').includes(searchTerm);
                row.style.display = matches ? '' : 'none';
            });
        }
        searchBox.addEventListener('input', applyFilters);

        function updateSelectedCount() {
            const checked = document.querySelectorAll('.quiz-checkbox:checked');
            selectedCountSpan.textContent = checked.length;
            deleteSelectedBtn.disabled = checked.length === 0;
        }
        document.querySelectorAll('.quiz-checkbox').forEach(cb => {
            cb.addEventListener('change', updateSelectedCount);
        });

        deleteSelectedBtn.addEventListener('click', function () {
            const checked = Array.from(document.querySelectorAll('.quiz-checkbox:checked'));
            const list = document.getElementById('deleteItemsList');
            list.innerHTML = '';

            checked.forEach(cb => {
                const li = document.createElement('li');
                li.className = 'list-group-item d-flex justify-content-between align-items-center';

                const checkWrap = document.createElement('div');
                checkWrap.className = 'form-check';
                const checkbox = document.createElement('input');
                checkbox.type = 'checkbox';
                checkbox.className = 'form-check-input me-2 modal-keep-checkbox';
                checkbox.checked = true;
                checkbox.dataset.id = cb.dataset.id;
                const label = document.createElement('label');
                label.className = 'form-check-label';
                label.textContent = cb.dataset.title;
                checkWrap.appendChild(checkbox);
                checkWrap.appendChild(label);

                li.appendChild(checkWrap);
                list.appendChild(li);
            });

            new bootstrap.Modal(document.getElementById('deleteConfirmModal')).show();
        });

        document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
            const idsToDelete = Array.from(document.querySelectorAll('.modal-keep-checkbox:checked'))
                .map(cb => cb.dataset.id);

            if (idsToDelete.length === 0) {
                alert('No items selected for deletion.');
                return;
            }

            const form = document.getElementById('bulkDeleteForm');
            form.innerHTML = '';

            const token = document.createElement('input');
            token.type = 'hidden';
            token.name = '__RequestVerificationToken';
            token.value = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            form.appendChild(token);

            idsToDelete.forEach(id => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'ids';
                input.value = id;
                form.appendChild(input);
            });

            form.submit();
        });
    </script>
}