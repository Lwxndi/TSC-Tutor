@model List<Tutor_Manager.ViewModels.SubjectListItemViewModel>
@{
    ViewData["Title"] = "Academic Setup";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Subjects</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Add Subject
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Subject</th>
            <th>Grades Offered</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var subject in Model)
        {
            <tr>
                <td>@subject.SubjectName</td>
                <td>
                    @if (subject.Grades.Any())
                    {
                        @string.Join(", ", subject.Grades.Select(g => (int)g))
                    }
                    else
                    {
                        <span class="text-muted">No grades assigned</span>
                    }
                </td>
                <td>
                    @(subject.IsActive ? "Active" : "Inactive")
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@subject.SubjectId" class="btn btn-sm btn-outline-secondary">
                        Edit
                    </a>
                    <form asp-action="ToggleActive" asp-route-id="@subject.SubjectId" method="post" class="d-inline">
                        <input type="hidden" name="isActive" value="@(!subject.IsActive ? "true" : "false")" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                            @(subject.IsActive ? "Deactivate" : "Activate")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
